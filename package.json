{
  "name": "todomd",
  "version": "0.1.0",
  "description": "Markdown-native kanban board for git repos that drives subscription coding agents through a Review → Plan → Build → Verify pipeline.",
  "type": "module",
  "bin": {
    "todomd": "bin/todomd.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    "docs",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/todomd.js",
    "test": "node --test test/*.test.js && node --test test/ui/*.test.js",
    "test:unit": "node --test test/*.test.js",
    "test:ui": "node --test test/ui/*.test.js",
    "ci": "node scripts/ci.mjs",
    "ci:quick": "node scripts/ci.mjs --quick"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "gray-matter": "^4.0.3",
    "imapflow": "^1.4.0",
    "js-yaml": "^4.1.0",
    "mailparser": "^3.9.9",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "license": "MIT",
  "author": "Irvin Bowman <bowman.irvin@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boneinis/todomd.git"
  },
  "homepage": "https://github.com/boneinis/todomd#readme",
  "bugs": "https://github.com/boneinis/todomd/issues",
  "keywords": [
    "kanban",
    "markdown",
    "ai-agents",
    "claude",
    "codex",
    "task-board",
    "git"
  ]
}
